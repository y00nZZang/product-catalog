{
  "name": "product-catalog",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "node scripts/build.cjs",
    "start": "node dist/server.js",
    "worker": "node dist/worker.js",
    "dev": "tsx src/server.ts",
    "dev:worker": "tsx src/worker.ts",
    "migrate": "tsx scripts/database/migrate.ts",
    "test": "tsx --test test/*.test.ts",
    "test:integration": "tsx scripts/testing/integration.ts",
    "probe": "tsx scripts/diagnostics/probe.ts",
    "metrics": "tsx scripts/diagnostics/metrics.ts",
    "evaluate": "tsx scripts/evaluation/evaluate.ts",
    "typecheck": "tsc -p tsconfig.check.json",
    "format:check": "prettier --check \"src/**/*.ts\" \"scripts/**/*.{ts,cjs}\" \"test/**/*.ts\" \"public/**/*.{js,css,html}\"",
    "evaluate:customs": "tsx scripts/evaluation/customs.ts"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.4",
    "@nestjs/core": "^12.0.4",
    "@nestjs/platform-express": "^12.0.4",
    "cheerio": "^1.2.0",
    "ipaddr.js": "^2.5.0",
    "openai": "^7.21.0",
    "pg": "^8.23.0",
    "playwright": "^1.63.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "undici": "^8.10.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.2",
    "@types/pg": "^8.23.1",
    "prettier": "^3.9.8",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
