DATABASE_URL=postgresql://catalog:catalog@localhost:55432/catalog
PORT=4310
HOST=127.0.0.1
EXECUTION_ENV=local
EXECUTION_REGION=local
CATALOG_PUBLIC_ACCESS=true
CATALOG_ACCESS_TOKEN=
BROWSER_ENABLED=true
# Reuse OPENAI_API_KEY from the process environment. Never commit a key.
LLM_ENABLED=false
OPENAI_MODEL=gpt-6-luna
OPENAI_DAILY_BUDGET_USD=0
OPENAI_CALL_RESERVE_USD=0.10
RAKUTEN_APPLICATION_ID=
RAKUTEN_ACCESS_KEY=

# Optional data.go.kr customs FX key; blank uses validated official public weekly rates.
CUSTOMS_API_KEY=
AUTO_CUSTOMS_ENABLED=true

OPENAI_API_KEY=
OPENAI_BUDGET_UNLIMITED=false
